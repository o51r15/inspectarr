[Unit]
Description=inspectarr — torrent watchdog web UI and scheduler
Documentation=https://github.com/o51r15/inspectarr
After=network.target

[Service]
Type=simple
User=inspectarr
Group=inspectarr
WorkingDirectory=/opt/inspectarr
ExecStart=/opt/inspectarr/venv/bin/python web.py
Environment=INSPECTARR_CONFIG=/opt/inspectarr/config.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inspectarr

[Install]
WantedBy=multi-user.target
