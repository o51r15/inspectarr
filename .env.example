# inspectarr - Environment Variables
# Copy to .env and adjust as needed. Docker Compose reads this automatically.

# User/group ID for the container process (avoids permission issues on bind mounts)
# Run id on the host to find your UID/GID.
PUID=1000
PGID=1000

# Override the default config file path inside the container
# Only needed if you mount config.yaml to a non-default location.
# INSPECTARR_CONFIG=/app/config.yaml
