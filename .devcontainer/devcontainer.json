{
  "name": "inspectarr-dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [8585],
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "remoteUser": "inspectarr",
  "mounts": [
    "source=inspectarr-data,target=/app/data,type=volume"
  ]
}
